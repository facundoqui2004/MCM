# Base de datos del sitio (mapas sin cuenta)
DATABASE_URL="file:./data/mindmaps.db"
# Turso / libSQL remoto:
# DATABASE_URL="libsql://tu-db.turso.io"
# DATABASE_AUTH_TOKEN=""

# Iniciar sesión con Google y guardar en Google Drive (ver README → "Guardar en Google Drive")
# Si faltan estas tres, la app funciona sin cuentas, como antes.
# GOOGLE_CLIENT_ID="1234567890-xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."
# AUTH_SECRET="un texto largo al azar (32+ caracteres)"

# Opcionales
# APP_URL="https://mcm-xi.vercel.app"   # si la app está detrás de otro dominio
# MAPS_REQUIRE_LOGIN="1"                # sin sesión no se puede usar la app
